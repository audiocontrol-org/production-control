  "rounds": 1,
  "liftedFindings": [
    {
      "id": "064713849c3d9f26::AUDIT-BARRAGE-claude-01",
      "title": "`npm test` discovers zero `.ts` test files on Node 20, so the suite gate can pass green having run nothing",
      "severity": "high"
    },
    {
      "id": "064713849c3d9f26::AUDIT-BARRAGE-claude-03",
      "title": "The bin shims `process.chdir()` into the package root, silently rebasing every relative path the operator passes",
      "severity": "high"
    },
    {
      "id": "0946dd77af3ad23f::AUDIT-BARRAGE-claude-01+AUDIT-BARRAGE-claude-02+AUDIT-BARRAGE-codex-01+AUDIT-BARRAGE-codex-02",
      "title": "`verbatim` destinations donate payload supply to a shared component but never consume any — re-opening the cross-unit false-clean AUDIT-20260726-17 closed",
      "severity": "high"
    },
    {
      "id": "2dffd55e56ad504d::AUDIT-BARRAGE-claude-01",
      "title": "Fixtures the US1 pass test depends on (`faithful-source.md`, `faithful-edition.md`) appear in no chunk of the diff",
      "severity": "high"
    },
    {
      "id": "2dffd55e56ad504d::AUDIT-BARRAGE-claude-02",
      "title": "The shape-guard tests never cover `JSON.parse` results that are `null`, an array, or a scalar — `typeof null === 'object'` re-opens the exact TypeError class the fix closed",
      "severity": "high"
    },
    {
      "id": "322b59e20e70e5b0::AUDIT-BARRAGE-claude-01",
      "title": "Fact 2 never exercises a producer VERSION CHANGE — it fabricates cross-target inconsistency, leaving the actual FR-027 upgrade scenario unobserved",
      "severity": "high"
    },
    {
      "id": "322b59e20e70e5b0::AUDIT-BARRAGE-claude-02",
      "title": "The \"model-version change\" half of US3 scenario 2 is asserted only in prose — the model is never varied, and no assertion ties model identity to `producer`",
      "severity": "high"
    },
    {
      "id": "343e020293434f91::AUDIT-BARRAGE-claude-01",
      "title": "Lexicon test asserts only the boolean flag over a fixture that must FAIL the lexicon obligation",
      "severity": "high"
    },
    {
      "id": "343e020293434f91::AUDIT-BARRAGE-codex-01",
      "title": "Lexicon applicability test passes on a lexicon-survival failure",
      "severity": "high"
    },
    {
      "id": "345c3996db49c18b::AUDIT-BARRAGE-claude-01",
      "title": "`unitId` test set is fully satisfied by an implementation that ignores `content_hash`, so a colliding durable identity would ship green",
      "severity": "high"
    },
    {
      "id": "345c3996db49c18b::AUDIT-BARRAGE-claude-02",
      "title": "No fixture pins deriveUnits behavior on an unterminated frontmatter block or an empty document — a silent zero-unit result makes unit accounting vacuously pass",
      "severity": "high"
    },
    {
      "id": "3c13c9b9b273f973::AUDIT-BARRAGE-claude-01+AUDIT-BARRAGE-claude-03+AUDIT-BARRAGE-codex-01",
      "title": "`unit_accounting` has no test for the double-disposition case — the \"exactly once\" half of its own stated invariant",
      "severity": "high"
    },
    {
      "id": "494bf79418727dbc::AUDIT-BARRAGE-claude-01",
      "title": "`voice-tooling` is a standalone npm install root wired into `pc build`, but nothing installs its dependencies on a fresh clone",
      "severity": "high"
    },
    {
      "id": "494bf79418727dbc::AUDIT-BARRAGE-claude-02",
      "title": "ESLint ignore for `voice-tooling/` carries a justification comment asserting a typing gate that no gate implements",
      "severity": "high"
    },
    {
      "id": "5c19dcf7daee2dd0::AUDIT-BARRAGE-claude-01+AUDIT-BARRAGE-codex-01",
      "title": "Model stdout is silently truncated at 32 MiB and the truncated text is returned as the edition",
      "severity": "high"
    },
    {
      "id": "5c19dcf7daee2dd0::AUDIT-BARRAGE-claude-02",
      "title": "`target` is interpolated straight into a filesystem path with no validation in the emit layer",
      "severity": "high"
    },
    {
      "id": "5c19dcf7daee2dd0::AUDIT-BARRAGE-claude-08+AUDIT-BARRAGE-codex-02",
      "title": "The expensive impure model call runs before the cheap `readPackageVersion` precondition it depends on",
      "severity": "high"
    },
    {
      "id": "667d9a7a87b9870b::AUDIT-BARRAGE-claude-01",
      "title": "`runFidelity` computes the verdict from `checks` alone, so any op-obligation failure whose kind isn't bucketed into one of the four named checks yields `passed: true` with a non-empty `failures[]`",
      "severity": "high"
    },
    {
      "id": "667d9a7a87b9870b::AUDIT-BARRAGE-codex-01",
      "title": "Empty lexicon terms can still escape as uncaught exceptions",
      "severity": "high"
    },
    {
      "id": "6c9e0010785d9e83::AUDIT-BARRAGE-claude-01",
      "title": "Golden suite reads eight `sources/` fixtures that appear nowhere in the diff — the fixture dir ships as `.gitkeep` only",
      "severity": "high"
    },
    {
      "id": "713190d5e947c398::AUDIT-BARRAGE-claude-01",
      "title": "Contract-permitted third input (lexicon / quote-bank) is refused, and the refusal misdiagnoses it as a duplicate source draft",
      "severity": "high"
    },
    {
      "id": "7258b46c95a69e2d::AUDIT-BARRAGE-claude-01",
      "title": "SC-004's \"applicable but unrun\" invariant is asserted in prose but pinned nowhere — `not-run` is unconditionally non-blocking, so the AUDIT-13/-16 required-key guard is satisfied by emitting `not-run`",
      "severity": "high"
    },
    {
      "id": "7258b46c95a69e2d::AUDIT-BARRAGE-claude-02",
      "title": "The missing-required-key regression guard is exercised on only 2 of the 10 required checks, so a guard implemented over an incomplete key list still passes green",
      "severity": "high"
    },
    {
      "id": "7258b46c95a69e2d::AUDIT-BARRAGE-claude-03",
      "title": "`target` is read off the wire and flows into the emitted filename with no refusal fixture — the value channel of an attacker/agent-controlled string is unaudited",
      "severity": "high"
    },
    {
      "id": "7258b46c95a69e2d::AUDIT-BARRAGE-claude-04",
      "title": "The declared-hash verification fix has exactly one fixture (source, wrong hex) — absent, malformed, and voice-input hash channels are all unfixtured",
      "severity": "high"
    },
    {
      "id": "7f6b5b0e60aad79f::AUDIT-BARRAGE-claude-01",
      "title": "The accepting-path fixture names its inputs `source`/`voice`, so the type-based discriminator the file exists to lock down is never actually exercised",
      "severity": "high"
    },
    {
      "id": "8af3d376655b0383::AUDIT-BARRAGE-claude-01+AUDIT-BARRAGE-codex-01",
      "title": "Declared input hashes in the `ValidateRequest` are shape-checked but never verified against the bytes actually read",
      "severity": "high"
    },
    {
      "id": "99eb9a5f83bad255::AUDIT-BARRAGE-claude-01",
      "title": "`findUnresolvedDestinationChecks` fabricates \"does not survive\" failures when only SOME declared destinations are unresolved",
      "severity": "high"
    },
    {
      "id": "99eb9a5f83bad255::AUDIT-BARRAGE-claude-02",
      "title": "A non-`cut` entry with an empty/absent `edition_units` produces failures that flip no named check",
      "severity": "high"
    },
    {
      "id": "99eb9a5f83bad255::AUDIT-BARRAGE-codex-01",
      "title": "Unsupported quote-bank input escapes as an exception instead of a validator refusal",
      "severity": "high"
    },
    {
      "id": "ac767d83a6b91407::AUDIT-BARRAGE-claude-01",
      "title": "FR-028's *refusal* half is untested, and the one test that claims to cover build-gate routing asserts a constant",
      "severity": "high"
    },
    {
      "id": "fdbfd5eb97ea6889::AUDIT-BARRAGE-claude-01",
      "title": "Byte input and string input derive different units for a BOM-prefixed source",
      "severity": "high"
    },
    {
      "id": "fdbfd5eb97ea6889::AUDIT-BARRAGE-codex-01",
      "title": "Fenced-code matching closes on any same-character fence prefix",
      "severity": "high"
    }
  ],
  "closedInLoopFindings": [],
