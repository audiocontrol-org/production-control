  "rounds": 1,
  "liftedFindings": [
    {
      "id": "0bd904b890cf8e70::AUDIT-BARRAGE-claude-01+AUDIT-BARRAGE-claude-04+AUDIT-BARRAGE-codex-01",
      "title": "REVISE leaves numerals inside an open-question marker required by neither multiset — and the new mode-scope fixture enshrines the hole",
      "severity": "high"
    },
    {
      "id": "0bd904b890cf8e70::AUDIT-BARRAGE-claude-02",
      "title": "The bracket-aware scanner's unbalanced-inner-`[` branch has no fixture — the two plausible behaviors are byte-loss and prose-swallowing",
      "severity": "high"
    },
    {
      "id": "1a520f3f85b5d788::AUDIT-BARRAGE-claude-01",
      "title": "`check-op-obligations-compose.test.ts` documents `loadLedger` as defaulting an absent mode to `'revise'`, directly contradicting the AUDIT-06 fail-closed note added in the same chunk",
      "severity": "high"
    },
    {
      "id": "30899172d937ce24::AUDIT-BARRAGE-claude-01",
      "title": "D8 forward reconciliation is only fixtured against a `framing` self-label — a `grounded` record that OMITS a beat coverage proves it carries has no test",
      "severity": "high"
    },
    {
      "id": "30899172d937ce24::AUDIT-BARRAGE-claude-02",
      "title": "Behavior with empty `coverage` and an honest `grounded` record is unpinned — both fail-open and refusal-storm implementations pass this suite",
      "severity": "high"
    },
    {
      "id": "30899172d937ce24::AUDIT-BARRAGE-claude-03",
      "title": "D8 reconciliation is only ever exercised with `op: 'represented'` — the `op` value channel is unfixtured",
      "severity": "high"
    },
    {
      "id": "5822a7921ed36b54::AUDIT-BARRAGE-claude-02",
      "title": "`finalize`'s `openQuestionMarkers` default `'none-declared'` fabricates a trust-boundary fact whenever a caller omits it",
      "severity": "high"
    },
    {
      "id": "5822a7921ed36b54::AUDIT-BARRAGE-codex-01",
      "title": "Compose-only checks are not required for a passing verdict",
      "severity": "high"
    },
    {
      "id": "677f86f7b980343e::AUDIT-BARRAGE-claude-01",
      "title": "Hash-keyed grounding refs collapse byte-identical units, so \"exactly one grounding record per edition unit\" is not decidable",
      "severity": "high"
    },
    {
      "id": "677f86f7b980343e::AUDIT-BARRAGE-codex-01",
      "title": "Model-leading frontmatter bypasses producer preflight’s unit view",
      "severity": "high"
    },
    {
      "id": "73034388c1ae1f3d::AUDIT-BARRAGE-claude-07+AUDIT-BARRAGE-codex-01",
      "title": "Marker comparison is a `Set`, so an edition that multiplies one spine marker N times passes both fabrication and survival, and no fixture covers the channel",
      "severity": "high"
    },
    {
      "id": "99475b25be025fe4::AUDIT-BARRAGE-claude-01",
      "title": "`op: 'represented'` with empty/absent `edition_units` is an undeclared cut that op-legality accepts in both modes",
      "severity": "high"
    },
    {
      "id": "99475b25be025fe4::AUDIT-BARRAGE-claude-02",
      "title": "Invented prose escapes grounding entirely by self-labeling `basis: 'connective'`; the AUDIT-04/17 fix only closed the `grounded`-with-zero-beats channel",
      "severity": "high"
    },
    {
      "id": "a2c247f951016dd5::AUDIT-BARRAGE-claude-01",
      "title": "Marker-survival and whole-unit no-copy are mutually unsatisfiable for a marker-only spine beat, and no fixture pins which invariant wins",
      "severity": "high"
    },
    {
      "id": "b140b7351b41afc5::AUDIT-BARRAGE-claude-01",
      "title": "SC-006 backward-compat test asserts the *defaulted* mode, not the fixture's absent-`mode` precondition — the guard can silently decay to a tautology",
      "severity": "high"
    },
    {
      "id": "b140b7351b41afc5::AUDIT-BARRAGE-claude-02",
      "title": "`runFidelity` is called with no `requested_mode` and asserted to pass — the mode-agreement check is skippable by omission, and no fixture pins that channel for a compose ledger",
      "severity": "high"
    },
    {
      "id": "b301c5822826fa08::AUDIT-BARRAGE-claude-01",
      "title": "Exhaustive no-copy sweep opens an unfixtured false-refusal channel: legitimate byte-identical carry-over (OPEN-QUESTION marker beats, headings, short structural lines) is indistinguishable from a copy",
      "severity": "high"
    },
    {
      "id": "b301c5822826fa08::AUDIT-BARRAGE-claude-08+AUDIT-BARRAGE-codex-01",
      "title": "Stale RED narration survives in the prompt-test header — the same shape the AUDIT-05 de-stale sweep fixed elsewhere",
      "severity": "high"
    },
    {
      "id": "b369ffb7381bae8b::AUDIT-BARRAGE-claude-02+AUDIT-BARRAGE-claude-03+AUDIT-BARRAGE-codex-01",
      "title": "`open_question_markers: 'enforced'` is computed from the spine alone and never consults whether any ledger op actually subjected that beat to payload survival",
      "severity": "high"
    },
    {
      "id": "c1aacb2aa61601cb::AUDIT-BARRAGE-claude-01",
      "title": "`runPreflight` dispatches modes by negation (`mode !== 'compose'`), so any future producer mode silently inherits the weakest self-check",
      "severity": "high"
    },
    {
      "id": "c1aacb2aa61601cb::AUDIT-BARRAGE-claude-02",
      "title": "revise branch filters op-legality failures by kind and silently drops every other kind — the exact fail-open the compose branch was hardened against",
      "severity": "high"
    },
    {
      "id": "c1aacb2aa61601cb::AUDIT-BARRAGE-claude-03+AUDIT-BARRAGE-claude-04+AUDIT-BARRAGE-codex-01",
      "title": "Compose prompt drops the blockquote / quoted-span byte-exactness clause that the revise prompt keeps, while its own doc comment says beats carry quoted spans",
      "severity": "high"
    },
    {
      "id": "cb8f20bd82b8559b::AUDIT-BARRAGE-claude-01",
      "title": "`CoverageLedger.mode` is optional on the type, re-opening the fail-open mode channel that AUDIT-06/09 closed in the validator",
      "severity": "high"
    },
    {
      "id": "f1f64f6aef3c4a9f::AUDIT-BARRAGE-claude-01",
      "title": "`check-no-copy` computes `ok` from a string-filtered subset of `checkOpLegality` failures with no exhaustiveness guard — any failure kind neither filter claims is silently swallowed",
      "severity": "high"
    }
  ],
  "closedInLoopFindings": [],
